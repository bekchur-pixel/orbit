# Optional: Behold.so feed id for a real Instagram wall
# Create a feed at https://behold.so and paste the id here
NEXT_PUBLIC_BEHOLD_FEED_ID=

# Optional: Instagram Graph API access token for a reliable automatic feed
# How to get: create a Facebook app, connect Instagram Basic Display/Graph,
# generate a long-lived user access token with instagram_basic scope.
INSTAGRAM_ACCESS_TOKEN=

# Optional: public site URL for OG metadata
NEXT_PUBLIC_SITE_URL=https://orbitgoall.vercel.app
